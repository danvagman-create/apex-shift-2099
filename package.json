{
  "name": "apex-shift-2099",
  "private": true,
  "version": "0.1.0",
  "description": "APEX SHIFT 2099 - futuristic browser 3D racing game built with Three.js, TypeScript and Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.mjs",
    "track-report": "esbuild scripts/track-report.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/track-report.mjs --log-level=warning && node node_modules/.cache/track-report.mjs"
  },
  "dependencies": {
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@types/three": "0.182.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  },
  "license": "UNLICENSED"
}
